# ===================================================
# Webworks Creator SaaS Platform - Environment Variables
# ===================================================

# App Environment
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_APP_NAME="Webworks"
NODE_ENV="development"

# Supabase Database & Auth
NEXT_PUBLIC_SUPABASE_URL="https://your-project.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-key-placeholder"
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key-placeholder"
DATABASE_URL="postgresql://postgres:password@db.your-project.supabase.co:5432/postgres"

# Stripe & Stripe Connect
STRIPE_SECRET_KEY="sk_test_placeholder"
STRIPE_WEBHOOK_SECRET="whsec_placeholder"
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="pk_test_placeholder"
STRIPE_CONNECT_CLIENT_ID="ca_placeholder"

# Email Delivery (Resend)
RESEND_API_KEY="re_placeholder"
EMAIL_FROM_ADDRESS="notifications@webworks.creator"

# AI Tools (Anthropic / OpenAI / Gemini)
GEMINI_API_KEY="your-gemini-api-key"
OPENAI_API_KEY="your-openai-api-key"

# Storage & CDN
NEXT_PUBLIC_STORAGE_BUCKET_URL="https://storage.webworks.creator"
